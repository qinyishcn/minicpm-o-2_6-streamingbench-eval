+"""Supervise the original Testbed CLI; all media/network logic stays there."""
+import argparse
+import hashlib
+import json
+import os
+import signal
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--root', required=True, help='Fresh prepare_rtc output directory')
+    parser.add_argument('--mode', required=True, choices=['single', 'native4'])
+    parser.add_argument('--profiles', nargs='+', required=True)
+    parser.add_argument('--profiles-file', default='configs/profiles.yaml')
+    parser.add_argument('--capture-root', required=True)
+    parser.add_argument('--runs', type=int, default=25)
+    parser.add_argument('--run-timeout', type=float)
+    parser.add_argument('--resume', action='store_true')
+    args = parser.parse_args()
+    if not 1 <= args.runs <= 25 or len(set(args.profiles)) != len(args.profiles):
+        parser.error('Expected 1..25 videos and unique profile names')
+    root = Path(args.root).resolve()
+    config_path = root / 'configs' / f'{args.mode}_scenarios.yaml'
+    model_path = Path(os.environ['MINICPM_RTC_CONFIG'])
+    model_config = json.loads(model_path.read_text(encoding='utf-8'))
+    if model_config['mode'] != args.mode:
+        raise ValueError('Client model configuration does not match --mode')
+    profiles_path = Path(args.profiles_file)
+    for profile in args.profiles:
+        output = root / args.mode / profile
+        output.mkdir(parents=True, exist_ok=True)
+        if (output / 'traffic.db').exists() and not args.resume:
+            raise ValueError('Existing traffic.db: use --resume or a fresh --root')
+        command = [sys.executable, '-u', 'orchestrator.py', '--scenario',
+                   'realtime_video_understanding', '--config', str(config_path),
+                   '--profiles', str(profiles_path), '--profile', profile,
+                   '--interface', 'lo', '--egress-only', '--runs', str(args.runs),
+                   '--db', str(output / 'traffic.db'), '--report',
+                   str(output / 'testbed_report.json'), '--capture-pcap',
+                   '--capture-filter', 'udp or tcp port 18124', '--capture-dir',
+                   str(Path(args.capture_root) / args.mode / profile), '--stop-on-error']
+        if args.run_timeout is not None:
+            command += ['--run-timeout', str(args.run_timeout)]
+        if args.resume:
+            command.append('--resume')
+        identity = {'command': command, 'started_at': time.time(),
+                    'model_config': model_config,
+                    'scenario_config_sha256': hashlib.sha256(config_path.read_bytes()).hexdigest(),
+                    'profiles_file_sha256': hashlib.sha256(profiles_path.read_bytes()).hexdigest(),
+                    'scope': 'original orchestrator; selected native question-frame adapter',
+                    'expected_questions': args.runs * 5}
+        with (output / 'invocations.jsonl').open('a', encoding='utf-8') as stream:
+            stream.write(json.dumps(identity) + '\n')
+        print(json.dumps({'mode': args.mode, 'profile': profile, 'status': 'starting',
+                          'expected_questions': args.runs * 5}), flush=True)
+        with (output / 'orchestrator.log').open('a') as log, (output / 'network_observations.jsonl').open('a') as observations:
+            process = subprocess.Popen(command, stdout=log, stderr=subprocess.STDOUT)
+            try:
+                while True:
+                    state = subprocess.run(['sudo', '-n', 'tc', '-s', '-j', 'qdisc', 'show', 'dev', 'lo'],
+                                           capture_output=True, text=True, check=True)
+                    observations.write(json.dumps({'time': time.time(),
+                        'qdisc': json.loads(state.stdout), 'snmp': Path('/proc/net/snmp').read_text()}) + '\n')
+                    observations.flush()
+                    if process.poll() is not None:
+                        break
+                    time.sleep(2)
+            finally:
+                if process.poll() is None:
+                    process.send_signal(signal.SIGINT)
+                    try:
+                        process.wait(timeout=30)
+                    except subprocess.TimeoutExpired:
+                        process.kill()
+                        process.wait()
+            if process.returncode:
+                raise RuntimeError(f'Original orchestrator failed: {args.mode}/{profile}/{process.returncode}')
+        results = []
+        for video_id in range(1, args.runs + 1):
+            path = root / 'dataset' / args.mode / f'sample_{video_id}' / f'questions_results_{profile}.json'
+            rows = json.loads(path.read_text(encoding='utf-8'))[0]['questions']
+            if len(rows) != 5 or any('minicpm_details' not in r for r in rows):
+                raise ValueError(f'Incomplete original benchmark result: {path}')
+            results.extend(rows)
+        if len({r['question_id'] for r in results}) != args.runs * 5:
+            raise ValueError('Duplicate or missing question identities')
+        print(json.dumps({'mode': args.mode, 'profile': profile, 'status': 'answers_saved',
+                          'questions': len(results), 'independent_audit': 'pending'}), flush=True)
+
+
+if __name__ == '__main__':
+    main()
