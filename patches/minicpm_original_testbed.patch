+"""Independently score original RTC results and audit feature erasure layout."""
+import argparse
+import csv
+import hashlib
+import json
+import math
+import re
+import statistics
+from pathlib import Path
+
+
+def score_rows(rows, expected):
+    seen, correct, invalid = set(), 0, 0
+    for row in rows:
+        qid = row['question_id']
+        if qid in seen or qid not in expected:
+            raise ValueError(f'Duplicate or unexpected question: {qid}')
+        if row['answer'] != expected[qid]['answer']:
+            raise ValueError(f'Ground-truth label changed: {qid}')
+        seen.add(qid)
+        raw = row['minicpm_details']['raw_response']
+        match = re.fullmatch(r'\s*\(?([ABCD])\)?[.)]?\s*', raw) if isinstance(raw, str) else None
+        prediction = match.group(1) if match else None
+        correct += prediction == expected[qid]['answer']
+        invalid += prediction is None
+    return {'questions': len(expected), 'answers_received': len(seen), 'correct': correct,
+            'accuracy_percent': 100 * correct / len(expected) if expected else None,
+            'invalid_responses': invalid, 'missing_answers': len(expected) - len(seen)}
+
+
+def validate_loss(detail):
+    length, loss = detail['feature_bytes'], detail['loss']
+    if not 0 < length <= 12 * 1024**2 or length % 4:
+        raise ValueError('Invalid F32 feature length')
+    size = loss['feature_payload_per_packet']
+    if size != 1080:
+        raise ValueError('Expected original Liquid RTP payload budget: 1080 feature bytes')
+    count = (length + size - 1) // size
+    missing = loss['missing_packet_indices']
+    if (loss['total_packets'] != count or len(missing) != len(set(missing))
+            or len(missing) != loss['missing_packets']
+            or loss['received_packets'] + len(missing) != count
+            or any(type(index) is not int or not 0 <= index < count for index in missing)):
+        raise ValueError('Inconsistent missing feature-fragment identities')
+    zeroed = sum(min(size, length - index * size) for index in missing)
+    if (loss['zeroed_bytes'] != zeroed
+            or not math.isclose(loss['zeroed_feature_fraction'], zeroed / length, abs_tol=1e-12)
+            or loss['duplicate_packets'] < 0):
+        raise ValueError('Inconsistent zero-filled byte count')
+    for key in ['feature_sha256', 'original_feature_sha256']:
+        if len(bytes.fromhex(detail[key])) != 32:
+            raise ValueError('Invalid feature SHA-256')
+    if not missing and detail['feature_sha256'] != detail['original_feature_sha256']:
+        raise ValueError('No-loss feature hash mismatch')
+    if len(missing) == count and detail['feature_sha256'] != hashlib.sha256(bytes(length)).hexdigest():
+        raise ValueError('Entire-message loss must produce an exactly all-zero feature buffer')
+
+
+def mean_field(rows, key):
+    values = [row['minicpm_details'][key] for row in rows if key in row['minicpm_details']]
+    if any(not math.isfinite(value) or value < 0 for value in values):
+        raise ValueError(f'Invalid timing: {key}')
+    return statistics.mean(values) if values else None
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--root', required=True)
+    parser.add_argument('--modes', nargs='+', choices=['single', 'native4'], default=['single', 'native4'])
+    parser.add_argument('--profiles', nargs='+', required=True)
+    parser.add_argument('--questions', help='Override saved manifest path for portable rescoring')
+    parser.add_argument('--video-limit', type=int, default=25)
+    parser.add_argument('--output', required=True)
+    parser.add_argument('--verify-images', action='store_true')
+    parser.add_argument('--reencode', action='store_true', help='Needs native GPU runtime and original frame cache')
+    args = parser.parse_args()
+    if (not 1 <= args.video_limit <= 25 or len(set(args.modes)) != len(args.modes)
+            or len(set(args.profiles)) != len(args.profiles) or 'no_emulation' not in args.profiles):
+        parser.error('Expected unique modes/profiles including no_emulation; 1..25 videos')
+    root, output = Path(args.root), Path(args.output)
+    output.mkdir(parents=True, exist_ok=True)
+    summaries, question_checks, configs = [], [], {}
+    for mode in args.modes:
+        config = json.loads((root / 'configs' / f'{mode}_model.json').read_text(encoding='utf-8'))
+        configs[mode] = config
+        manifest = Path(args.questions or config['questions']).read_bytes()
+        if hashlib.sha256(manifest).hexdigest() != config['questions_sha256']:
+            raise ValueError('Question manifest SHA-256 mismatch')
+        all_questions = json.loads(manifest)
+        if len(all_questions) != 125 or len({r['question_id'] for r in all_questions}) != 125:
+            raise ValueError('Expected the fixed 125-question manifest')
+        expected = {r['question_id']: r for r in all_questions if r['video_id'] <= args.video_limit}
+        if len(expected) != args.video_limit * 5:
+            raise ValueError('Expected exactly five fixed questions per selected video')
+        sources = {}
+        for profile in args.profiles:
+            rows = []
+            for video_id in range(1, args.video_limit + 1):
+                path = root / 'dataset' / mode / f'sample_{video_id}' / f'questions_results_{profile}.json'
+                rows.extend(json.loads(path.read_text(encoding='utf-8'))[0]['questions'])
+            score = score_rows(rows, expected)
+            if score['missing_answers']:
+                raise ValueError(f'Incomplete {mode}/{profile}: {score}')
+            sources[profile] = {r['question_id']: r for r in rows}
+            summaries.append({'mode': mode, 'profile': profile, **score,
+                'feature_packets': sum(r['minicpm_details']['loss']['total_packets'] for r in rows),
+                'missing_feature_packets': sum(r['minicpm_details']['loss']['missing_packets'] for r in rows),
+                'feature_bytes': sum(r['minicpm_details']['feature_bytes'] for r in rows),
+                'zeroed_feature_bytes': sum(r['minicpm_details']['loss']['zeroed_bytes'] for r in rows),
+                'mean_edge_encode_seconds': mean_field(rows, 'edge_encode_seconds'),
+                'mean_server_inference_seconds': mean_field(rows, 'server_inference_seconds'),
+                'mean_metadata_to_result_seconds': mean_field(rows, 'metadata_to_result_seconds')})
+        vision = None
+        if args.reencode:
+            from .native import EdgeVision
+            vision = EdgeVision(config['runtime'], config['tokenizer'], config['projector'])
+        try:
+            for qid, question in expected.items():
+                baseline = sources['no_emulation'][qid]['minicpm_details']
+                payload = None
+                if args.verify_images or args.reencode:
+                    from .client import PROMPT, load_frames
+                    folder = Path(config['frames']) / qid.replace(' ', '_')
+                    frames = load_frames(folder, question, mode)
+                    if frames != baseline['frames']:
+                        raise ValueError(f'Native frame-cache metadata mismatch: {qid}')
+                    if vision:
+                        _, payload = vision.encode([folder / f['file'] for f in frames],
+                                                   PROMPT.format(question['question'], *question['options']))
+                for profile in args.profiles:
+                    row = sources[profile][qid]
+                    detail = row['minicpm_details']
+                    for key in ['question', 'options', 'timestamp_seconds', 'video_id']:
+                        if row[key] != question[key]:
+                            raise ValueError(f'Benchmark input changed: {qid}/{key}')
+                    if detail['question_id'] != qid or detail['mode'] != mode:
+                        raise ValueError('Feature record identity mismatch')
+                    validate_loss(detail)
+                    frames = detail['frames']
+                    if (len(frames) != (1 if mode == 'single' else 4)
+                            or frames != baseline['frames']
+                            or detail['original_feature_sha256'] != baseline['original_feature_sha256']):
+                        raise ValueError(f'Visual input changed across profiles: {qid}')
+                    indices = [frame['frame_index'] for frame in frames]
+                    if indices != list(range(indices[0], indices[0] + len(frames))):
+                        raise ValueError('Expected consecutive native video frame indices')
+                    if any(frame['actual_seconds'] > question['timestamp_seconds'] + 1e-6 for frame in frames):
+                        raise ValueError('Future frame in question input')
+                    if detail['raw_response'] != row['minicpm']:
+                        raise ValueError('Raw model response differs from benchmark result')
+                    if 'result' in detail and detail['result']['text'] != detail['raw_response']:
+                        raise ValueError('Native language result differs from saved response')
+                    if payload is not None:
+                        if hashlib.sha256(payload).hexdigest() != detail['original_feature_sha256']:
+                            raise ValueError(f'Re-encoded original features differ: {qid}')
+                        damaged = bytearray(payload)
+                        size = detail['loss']['feature_payload_per_packet']
+                        for index in detail['loss']['missing_packet_indices']:
+                            begin, end = index * size, min((index + 1) * size, len(damaged))
+                            damaged[begin:end] = bytes(end - begin)
+                        if hashlib.sha256(damaged).hexdigest() != detail['feature_sha256']:
+                            raise ValueError(f'Actual received zero-filled features differ: {qid}/{profile}')
+                    question_checks.append({'mode': mode, 'profile': profile, 'question_id': qid,
+                        'original_feature_sha256': detail['original_feature_sha256'],
+                        'feature_sha256': detail['feature_sha256'],
+                        'missing_packets': detail['loss']['missing_packets'],
+                        'zero_fill_hash_reconstructed': payload is not None})
+        finally:
+            if vision:
+                vision.close()
+    for row in summaries:
+        row['missing_feature_percent'] = 100 * row['missing_feature_packets'] / row['feature_packets']
+        row['zeroed_feature_percent'] = 100 * row['zeroed_feature_bytes'] / row['feature_bytes']
+    diagnostic = args.video_limit != 25
+    audit = {'status': 'passed', 'scope': 'diagnostic subset' if diagnostic else 'fixed 125-question conditions',
+             'videos_per_condition': args.video_limit, 'conditions': len(summaries),
+             'answers': sum(r['answers_received'] for r in summaries),
+             'reencoded_feature_audit': args.reencode, 'frame_cache_verified': args.verify_images or args.reencode,
+             'source_configs': configs, 'summary': summaries, 'question_checks': question_checks,
+             'timing_definition': {'mean_metadata_to_result_seconds':
+                 'server metadata registration to complete answer; excludes edge encoding and return trip',
+                 'mean_server_inference_seconds': 'native language-model call including serial GPU queue wait',
+                 'mean_edge_encode_seconds': 'native vision preprocessing, encoding and feature copy'}}
+    (output / 'audit.json').write_text(json.dumps(audit, indent=2), encoding='utf-8')
+    with (output / 'condition_summary.csv').open('w', newline='', encoding='utf-8-sig') as stream:
+        writer = csv.DictWriter(stream, fieldnames=list(summaries[0]))
+        writer.writeheader()
+        writer.writerows(summaries)
+    lines = ['# MiniCPM：原版 Testbed RTC 结果核验', '',
+        f'范围：每条件 {args.video_limit} 个视频、{args.video_limit * 5} 道题，共 {audit["answers"]} 次回答。',
+        '**这是小样本诊断，不能作为完整 125 题性能结果。**' if diagnostic else
+        '每条件均覆盖固定 125 题；无效或缺失答案计错，准确率分母不随成功响应数量改变。', '',
+        '| 输入 | 原版 profile | 答对/题数 | 准确率 | 实际特征包缺失 | 特征置零比例 |',
+        '|---|---|---:|---:|---:|---:|']
+    for r in summaries:
+        lines.append(f'| {r["mode"]} | {r["profile"]} | {r["correct"]}/{r["questions"]} | '
+                     f'{r["accuracy_percent"]:.1f}% | {r["missing_feature_percent"]:.3f}% | '
+                     f'{r["zeroed_feature_percent"]:.3f}% |')
+    lines += ['', '特征经原版 aiortc 的 UDP/RTP/SRTP 发送；TCP 用于信令，可靠 DataChannel 用于控制与答案。'
+        '缺包按原 F32 位置置零。没有修改原网络 profile 的带宽、时延、丢包概率或队列容量。',
+        '实际特征缺失包括网络与队列丢包以及重组/截止时限造成的不可用，不能当作配置随机丢包率。'
+        '每包特征载荷 1080 字节，与此前离线 1432 字节预算不同。',
+        '当前适配器仅按问题顺序传输指定的原生单帧/四帧特征；视频帧索引保持原生连续。'
+        '本报告不证明持续原生 FPS 视频编码、传输或推理吞吐率。',
+        f'GPU 重新编码及受损特征字节哈希重建：{args.reencode}；原始帧缓存核验：'
+        f'{args.verify_images or args.reencode}。CPU 审计仅核对保存的哈希与缺包布局，'
+        '部分丢包的字节级重建需要 --reencode。',
+        'metadata_to_result_seconds 从服务器收到元数据计时至完整答案生成，不含端侧编码和答案回传；'
+        '不是端到端延迟。服务器推理计时包含串行 GPU 队列等待。'
+        '完整答案一次性返回，未测得逐 token TTFT。',
+        '此处原生运行时为 Linux CUDA，与此前 Windows Vulkan 离线实验的数值精度可能不同。'
+        '各 profile 应与同一 Linux/RTC no_emulation 条件比较。', '']
+    (output / 'report_zh.md').write_text('\n'.join(lines), encoding='utf-8')
+    print(json.dumps({'audit': 'passed', 'answers': audit['answers'], 'summary': summaries}, indent=2))
+
+
+if __name__ == '__main__':
+    main()
diff --git a/aitestbed/minicpm_split/packet_loss.py b/aitestbed/minicpm_split/packet_loss.py
new file mode 100644
--- /dev/null
+++ b/aitestbed/minicpm_split/packet_loss.py
@@ -0,0 +1,164 @@
+"""Offline MTU-sized feature erasure, followed by real language-model inference."""
+import argparse
+import hashlib
+import json
+import math
+import random
+import re
+import statistics
+import time
+from pathlib import Path
+
+from .client import PROMPT, load_frames, request
+from .native import EdgeVision, MODEL_SHA, PROJECTOR_SHA, TOKENIZER_SHA, RUNTIME_SHA
+
+# IP MTU excludes the Ethernet header. Budget a minimal IPv4/UDP/RTP packet,
+# a 16-byte feature-fragment header and the 10-byte SRTP AES-CM auth tag.
+# This is an offline size model, not a claim to encrypt or send SRTP packets.
+OVERHEAD = {'ipv4':20, 'udp':8, 'rtp':12, 'feature_fragment_header':16, 'srtp_auth_tag':10}
+
+
+def packet_ranges(length, mtu=1500):
+    available = (mtu-sum(OVERHEAD.values()))//4*4
+    if length < 0 or length % 4 or available < 4:
+        raise ValueError('Feature buffer and packet budget must hold whole float32 elements')
+    return [(offset,min(available,length-offset)) for offset in range(0,length,available)]
+
+
+def zero_packets(payload, loss_rate, seed, mtu=1500):
+    if not math.isfinite(loss_rate) or not 0<=loss_rate<=1:
+        raise ValueError('Loss rate must be between zero and one')
+    ranges = packet_ranges(len(payload),mtu)
+    rng, damaged, lost, zeroed = random.Random(seed), bytearray(payload), [], 0
+    for index,(offset,size) in enumerate(ranges):
+        if rng.random() < loss_rate:
+            damaged[offset:offset+size] = bytes(size)
+            lost.append(index)
+            zeroed += size
+    return bytes(damaged), {'mtu':mtu, 'feature_payload_per_full_packet':ranges[0][1] if ranges else 0,
+        'header_budget':OVERHEAD, 'nominal_loss_rate':loss_rate, 'seed':seed,
+        'total_packets':len(ranges), 'lost_packets':len(lost), 'lost_packet_indices':lost,
+        'observed_packet_loss_rate':len(lost)/len(ranges) if ranges else 0,
+        'zeroed_bytes':zeroed, 'zeroed_float32_elements':zeroed//4,
+        'zeroed_feature_fraction':zeroed/len(payload) if payload else 0}
+
+
+def summarize(predictions):
+    correct = sum(r['correct'] for r in predictions)
+    packets = sum(r['loss']['total_packets'] for r in predictions)
+    lost = sum(r['loss']['lost_packets'] for r in predictions)
+    return {'status':'complete' if len(predictions)==125 else 'partial', 'evaluated':len(predictions),
+            'correct':correct, 'accuracy_percent':100*correct/125,
+            'completed_question_accuracy_percent':100*correct/len(predictions) if predictions else 0,
+            'missing_questions':125-len(predictions),
+            'invalid_responses':sum(r['prediction'] is None for r in predictions),
+            'total_packets':packets, 'lost_packets':lost,
+            'observed_packet_loss_rate':lost/packets if packets else 0,
+            'zeroed_feature_fraction':sum(r['loss']['zeroed_bytes'] for r in predictions)/
+                sum(r['feature_bytes'] for r in predictions) if predictions else 0,
+            'mean_request_to_response_seconds':statistics.mean(r['request_to_response_seconds'] for r in predictions)
+                if predictions else None}
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--runtime', required=True)
+    parser.add_argument('--projector', required=True)
+    parser.add_argument('--tokenizer', default='models/minicpm-o-tokenizer-only.gguf')
+    parser.add_argument('--questions', required=True)
+    parser.add_argument('--frames', required=True)
+    parser.add_argument('--output', required=True)
+    parser.add_argument('--host', default='127.0.0.1')
+    parser.add_argument('--port', type=int, default=18087)
+    parser.add_argument('--mtu', type=int, default=1500)
+    parser.add_argument('--seed', type=int, default=20261009)
+    parser.add_argument('--loss-rates', type=float, nargs='+', default=[0,.001,.01,.05,.1,.2])
+    parser.add_argument('--limit', type=int, default=125)
+    args = parser.parse_args()
+    if not 1<=args.limit<=125 or len(set(args.loss_rates))!=len(args.loss_rates):
+        parser.error('Expected 1..125 questions and unique loss rates')
+    for rate in args.loss_rates:
+        zero_packets(bytes(4),rate,1,args.mtu)
+    manifest = Path(args.questions).read_bytes()
+    rows = json.loads(manifest)
+    if len(rows)!=125 or len({r['question_id'] for r in rows})!=125:
+        raise ValueError('Expected the verified 125-question manifest')
+    output = Path(args.output)
+    output.mkdir(parents=True,exist_ok=True)
+    config = {'experiment':'offline Bernoulli feature packet erasure; erased bytes -> positive float32 zero',
+              'mtu':args.mtu,'header_budget':OVERHEAD,'feature_payload_per_full_packet':packet_ranges(10000,args.mtu)[0][1],
+              'loss_rates':args.loss_rates,'seed':args.seed,'random_seeds':1,
+              'mask_pairing':'same per-question uniforms at all rates; higher-rate masks contain lower-rate masks',
+              'question_seed_derivation':'first 8 bytes of SHA256(seed|mode|question_id), big endian',
+              'expected_questions_per_condition':125,'modes':['single','native4'],
+              'questions_sha256':hashlib.sha256(manifest).hexdigest(),
+              'model_sha256':MODEL_SHA,'projector_sha256':PROJECTOR_SHA,'tokenizer_sha256':TOKENIZER_SHA,
+              'runtime':'llama.cpp b11516 Windows Vulkan x64','runtime_dll_sha256':RUNTIME_SHA,
+              'language_quantization':'Q4_K_M','vision_weights':'F16','wire_dtype':'<f4',
+              'context':4096,'max_tokens':16,'temperature':0,'prompt_template':PROMPT,
+              'network_emulation':False,'actual_transport':'local TCP; erasure happens before sending',
+              'images_transmitted':False,'feature_concealment':'zero only; no retransmission/FEC/temporal reuse',
+              'scope':'first 25 videos, 5 questions each; latest past native frame or previous 3 plus current',
+              'preprocessing':'verified 588x336 JPEG cache, no temporal resampling'}
+    config_path = output/'config.json'
+    if config_path.exists() and json.loads(config_path.read_text())!=config:
+        raise ValueError('Existing experiment configuration differs; use a new output directory')
+    config_path.write_text(json.dumps(config,indent=2),encoding='utf-8')
+    health,_,_,_ = request(args.host,args.port,{'op':'health'})
+    if health['vision_weights_loaded']:
+        raise ValueError('Expected a language-only server')
+    conditions = {}
+    for mode in config['modes']:
+        for rate in args.loss_rates:
+            folder = output/mode/f'loss_{rate:g}'
+            folder.mkdir(parents=True,exist_ok=True)
+            path = folder/'predictions.jsonl'
+            existing = [json.loads(line) for line in path.read_text(encoding='utf-8').splitlines()] if path.exists() else []
+            by_id = {r['question_id']:r for r in existing}
+            if len(by_id)!=len(existing) or not set(by_id)<=set(r['question_id'] for r in rows):
+                raise ValueError('Duplicate or unknown existing prediction')
+            conditions[mode,rate] = folder,existing,by_id
+    edge = EdgeVision(args.runtime,args.tokenizer,args.projector)
+    try:
+        for mode in config['modes']:
+            for index,row in enumerate(rows[:args.limit],1):
+                todo = [rate for rate in args.loss_rates if row['question_id'] not in conditions[mode,rate][2]]
+                if not todo:
+                    continue
+                folder = Path(args.frames)/row['question_id'].replace(' ','_')
+                frames = load_frames(folder,row,mode)
+                metadata, original = edge.encode([folder/f['file'] for f in frames],
+                                                  PROMPT.format(row['question'],*row['options']))
+                metadata.update(question_id=row['question_id'],frames=frames,max_tokens=16)
+                seed = int.from_bytes(hashlib.sha256(f'{args.seed}|{mode}|{row["question_id"]}'.encode()).digest()[:8],'big')
+                for rate in todo:
+                    damaged,loss = zero_packets(original,rate,seed,args.mtu)
+                    response,sent,received,duration = request(args.host,args.port,metadata,damaged)
+                    raw = response['result']['text']
+                    match = re.fullmatch(r'\s*\(?([ABCD])\)?[.)]?\s*',raw)
+                    answer = match.group(1) if match else None
+                    result = dict(response,mode=mode,question_id=row['question_id'],video_id=row['video_id'],
+                        label=row['answer'],prediction=answer,raw_response=raw,correct=answer==row['answer'],
+                        loss=loss,feature_bytes=len(original),request_bytes=sent,response_bytes=received,
+                        original_feature_sha256=hashlib.sha256(original).hexdigest(),
+                        damaged_feature_sha256=hashlib.sha256(damaged).hexdigest(),
+                        edge_encode_seconds=metadata['edge_encode_seconds'],request_to_response_seconds=duration,
+                        frames=frames,timestamp=time.time(),server_pid=health['pid'])
+                    target,predictions,by_id = conditions[mode,rate]
+                    with (target/'predictions.jsonl').open('a',encoding='utf-8') as stream:
+                        stream.write(json.dumps(result)+'\n')
+                    predictions.append(result)
+                    by_id[row['question_id']] = result
+                    (target/'summary.json').write_text(json.dumps(summarize(predictions),indent=2),encoding='utf-8')
+                    print(f'{mode} {index}/125 loss={rate:g} {answer}/{row["answer"]} '
+                          f'lost={loss["lost_packets"]}/{loss["total_packets"]} time={duration:.3f}',flush=True)
+    finally:
+        edge.close()
+    summary = [{'mode':mode,'nominal_loss_rate':rate,**summarize(values[1])}
+               for (mode,rate),values in conditions.items()]
+    (output/'summary.json').write_text(json.dumps(summary,indent=2),encoding='utf-8')
+    print(json.dumps(summary,indent=2),flush=True)
+
+
+if __name__=='__main__':
+    main()
