+import tempfile
+import unittest
+from pathlib import Path
+from PIL import Image
+from minicpm_split.rtc_codec import MiniCPMEncoder
+from minicpm_split.rtc_track import MiniCPMQuestionTrack
+
+
+class NativeTrackTests(unittest.TestCase):
+    def test_questions_follow_source_time_even_when_question_numbers_do_not(self):
+        with tempfile.TemporaryDirectory() as folder:
+            root=Path(folder)
+            rows=[]
+            for index,query in enumerate([4,8,6,10,12]):
+                row={'video_id':1,'question_id':f'q{index}','timestamp_seconds':query}
+                rows.append(row)
+                cache=root/'frames'/row['question_id']
