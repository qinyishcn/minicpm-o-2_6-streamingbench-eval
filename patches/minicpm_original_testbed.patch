new file mode 100644
--- /dev/null
+++ b/aitestbed/minicpm_split/rtp_features.py
@@ -0,0 +1,57 @@
+"""MiniCPM feature fragments for the Testbed's RTP codec, with zero concealment."""
+import struct
+
+HEADER=struct.Struct('!IIII')  # message id, byte offset, full length, fragment length
+FEATURE_PAYLOAD=1080  # retain Liquid's 1100-byte RTP payload cap, less 16+4 headers
+MAX_FEATURE_BYTES=12*1024**2
+
+
+def fragment_features(payload,message_id):
+    if not payload or len(payload)%4 or len(payload)>MAX_FEATURE_BYTES:
+        raise ValueError('Expected a bounded nonempty float32 feature buffer')
+    if not 0<=message_id<=0xffffffff:
+        raise ValueError('Invalid feature message id')
+    return [HEADER.pack(message_id,offset,len(payload),len(payload[offset:offset+FEATURE_PAYLOAD]))+
+            payload[offset:offset+FEATURE_PAYLOAD] for offset in range(0,len(payload),FEATURE_PAYLOAD)]
+
+
+class FeatureAssembler:
+    def __init__(self,length,message_id):
+        if not 0<length<=MAX_FEATURE_BYTES or length%4:
+            raise ValueError('Invalid expected feature size')
+        self.length,self.message_id=length,message_id
+        self.buffer=bytearray(length)
+        self.seen=set()
+        self.duplicates=0
+
+    def add(self,data):
+        position=0
+        while position<len(data):
+            if len(data)-position<HEADER.size:
+                raise ValueError('Truncated feature fragment header')
+            message_id,offset,total,size=HEADER.unpack_from(data,position)
+            position+=HEADER.size
+            expected_size=min(FEATURE_PAYLOAD,self.length-offset)
+            if (message_id!=self.message_id or total!=self.length or offset>=self.length or
+                    offset%FEATURE_PAYLOAD or size!=expected_size or size%4 or size<4 or
+                    len(data)-position<size):
+                raise ValueError('Invalid feature fragment layout or message identity')
+            fragment=data[position:position+size]
+            index=offset//FEATURE_PAYLOAD
+            if index in self.seen:
+                if self.buffer[offset:offset+size]!=fragment:
+                    raise ValueError('Conflicting duplicate feature fragment')
+                self.duplicates+=1
+            else:
+                self.buffer[offset:offset+size]=fragment
+                self.seen.add(index)
+            position+=size
+
+    def finish(self):
+        count=(self.length+FEATURE_PAYLOAD-1)//FEATURE_PAYLOAD
+        missing=[i for i in range(count) if i not in self.seen]
+        zeroed=sum(min(FEATURE_PAYLOAD,self.length-i*FEATURE_PAYLOAD) for i in missing)
+        return bytes(self.buffer),{'total_packets':count,'received_packets':len(self.seen),
+            'missing_packets':len(missing),'missing_packet_indices':missing,
+            'zeroed_bytes':zeroed,'zeroed_feature_fraction':zeroed/self.length,
+            'duplicate_packets':self.duplicates,'feature_payload_per_packet':FEATURE_PAYLOAD}
diff --git a/aitestbed/minicpm_split/rtc_codec.py b/aitestbed/minicpm_split/rtc_codec.py
