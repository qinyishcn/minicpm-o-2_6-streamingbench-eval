+import hashlib
+import unittest
+
+from minicpm_split.rtc_report import score_rows, validate_loss
+
+
+class RTCReportTests(unittest.TestCase):
+    def test_invalid_and_missing_answers_are_wrong_with_fixed_denominator(self):
+        expected = {f'q{i}': {'answer': answer} for i, answer in enumerate(['A', 'B', 'C'])}
+        rows = [{'question_id': 'q0', 'answer': 'A', 'minicpm_details': {'raw_response': 'A'}},
+                {'question_id': 'q1', 'answer': 'B', 'minicpm_details': {'raw_response': 'unknown'}}]
+        score = score_rows(rows, expected)
+        self.assertEqual(score['correct'], 1)
+        self.assertEqual(score['questions'], 3)
+        self.assertEqual(score['answers_received'], 2)
+        self.assertEqual(score['invalid_responses'], 1)
+        self.assertEqual(score['missing_answers'], 1)
+        self.assertAlmostEqual(score['accuracy_percent'], 100 / 3)
+
+    def test_duplicate_unknown_and_modified_labels_are_rejected(self):
+        row = {'question_id': 'q', 'answer': 'A', 'minicpm_details': {'raw_response': 'A'}}
+        expected = {'q': {'answer': 'A'}}
+        for rows, labels in [([row, row], expected), ([row], {}),
+                             ([row], {'q': {'answer': 'B'}})]:
+            with self.assertRaises(ValueError):
+                score_rows(rows, labels)
+
+    def test_tail_fragment_zero_budget_and_entire_message_zero_hash(self):
+        zero_hash = hashlib.sha256(bytes(1084)).hexdigest()
+        detail = {'feature_bytes': 1084, 'feature_sha256': zero_hash,
+                  'original_feature_sha256': 'a' * 64, 'loss': {
+            'feature_payload_per_packet': 1080, 'total_packets': 2,
+            'received_packets': 1, 'missing_packets': 1,
+            'missing_packet_indices': [1], 'zeroed_bytes': 4,
+            'zeroed_feature_fraction': 4 / 1084, 'duplicate_packets': 0}}
+        validate_loss(detail)
+        detail['loss'].update(received_packets=0, missing_packets=2,
+            missing_packet_indices=[0, 1], zeroed_bytes=1084, zeroed_feature_fraction=1)
+        validate_loss(detail)
+        detail['feature_sha256'] = 'b' * 64
+        with self.assertRaises(ValueError):
+            validate_loss(detail)
+
+    def test_invalid_missing_offsets_and_false_no_loss_hash_are_rejected(self):
+        detail = {'feature_bytes': 1084, 'feature_sha256': 'a' * 64,
+                  'original_feature_sha256': 'b' * 64, 'loss': {
+            'feature_payload_per_packet': 1080, 'total_packets': 2,
+            'received_packets': 2, 'missing_packets': 0,
+            'missing_packet_indices': [], 'zeroed_bytes': 0,
+            'zeroed_feature_fraction': 0, 'duplicate_packets': 0}}
+        with self.assertRaises(ValueError):
+            validate_loss(detail)
+        detail['feature_sha256'] = detail['original_feature_sha256']
+        validate_loss(detail)
+        detail['loss'].update(received_packets=1, missing_packets=1,
+                              missing_packet_indices=[2], zeroed_bytes=4)
+        with self.assertRaises(ValueError):
+            validate_loss(detail)
+
+
+if __name__ == '__main__':
+    unittest.main()
