@@ -0,0 +1,55 @@
+import struct
+import unittest
+
+from minicpm_split.rtp_features import FeatureAssembler, fragment_features, FEATURE_PAYLOAD
+
+
+class RTPFeatureTests(unittest.TestCase):
+    def test_large_offsets_and_mtu_budget(self):
+        payload=struct.pack('<20000f',*([1.25]*20000))
+        fragments=fragment_features(payload,17)
+        self.assertTrue(any(struct.unpack_from('!IIII',p)[1]>65535 for p in fragments))
+        self.assertTrue(all(len(p)+4+20+8+12+16+16<=1500 for p in fragments))
+        assembler=FeatureAssembler(len(payload),17)
+        assembler.add(b''.join(reversed(fragments)))
+        actual,stats=assembler.finish()
+        self.assertEqual(actual,payload)
+        self.assertEqual(stats['missing_packets'],0)
+
+    def test_missing_packet_zeros_only_its_float_positions(self):
+        payload=struct.pack('<2000f',*([2.5]*2000))
+        fragments=fragment_features(payload,9)
+        assembler=FeatureAssembler(len(payload),9)
+        assembler.add(b''.join(p for i,p in enumerate(fragments) if i!=1))
+        actual,stats=assembler.finish()
+        expected=bytearray(payload)
+        expected[FEATURE_PAYLOAD:2*FEATURE_PAYLOAD]=bytes(FEATURE_PAYLOAD)
+        self.assertEqual(actual,bytes(expected))
+        self.assertEqual(stats['missing_packet_indices'],[1])
+        self.assertEqual(stats['zeroed_bytes'],FEATURE_PAYLOAD)
+
+    def test_duplicate_and_total_loss_do_not_reuse_another_question(self):
+        payload=struct.pack('<800f',*([3.0]*800))
+        fragments=fragment_features(payload,3)
+        assembler=FeatureAssembler(len(payload),3)
+        assembler.add(fragments[0]+fragments[0])
+        self.assertEqual(assembler.finish()[1]['duplicate_packets'],1)
+        other=FeatureAssembler(len(payload),4)
+        self.assertEqual(other.finish()[0],bytes(len(payload)))
+        with self.assertRaises(ValueError):
+            other.add(fragments[0])
+
+    def test_truncated_misaligned_and_conflicting_fragments_rejected(self):
+        fragments=fragment_features(bytes(4000),5)
+        for damaged in [fragments[0][:-1],struct.pack('!IIII',5,1,4000,4)+bytes(4),
+                        struct.pack('!IIII',5,0,4000,FEATURE_PAYLOAD+4)+bytes(FEATURE_PAYLOAD+4)]:
+            with self.assertRaises(ValueError):
+                FeatureAssembler(4000,5).add(damaged)
+        assembler=FeatureAssembler(4000,5)
+        assembler.add(fragments[0])
+        with self.assertRaises(ValueError):
+            assembler.add(fragments[0][:-1]+b'\x01')
+
+
+if __name__=='__main__':
+    unittest.main()
