+import unittest
+from aiortc.jitterbuffer import JitterBuffer
+from aiortc.rtp import RtpPacket
+
+
+def packet(sequence,timestamp,data=b'x'):
+    result=RtpPacket(payload_type=105,sequence_number=sequence%65536,timestamp=timestamp)
+    result._data=data
+    return result
+
+
+class MiniCPMJitterTests(unittest.TestCase):
+    def test_large_feature_frame_survives_original_jitter_path(self):
+        buffer=JitterBuffer(capacity=512,is_video=True)
+        for index in range(12000):
+            _,frame=buffer.add(packet(65000+index,100,b'a'),'tokenIdMiniCPM')
+            self.assertIsNone(frame)
+        _,frame=buffer.add(packet(65000+12000,200,b'b'),'tokenIdMiniCPM')
+        self.assertEqual(frame.data,b'a'*12000)
+        self.assertEqual(frame.timestamp,100)
+
+    def test_final_partial_frame_flushes_without_terminal_packet(self):
+        buffer=JitterBuffer(capacity=512,is_video=True)
+        buffer.add(packet(7,100,b'a'),'tokenIdMiniCPM')
+        buffer.add(packet(9,100,b'c'),'tokenIdMiniCPM')
+        frame=buffer.flush_minicpm()
+        self.assertEqual(frame.data,b'ac')
+        self.assertEqual(frame.timestamp,100)
+        self.assertIsNone(buffer.flush_minicpm())
+
+    def test_liquid_token_frame_still_uses_original_loss_tolerant_path(self):
+        buffer=JitterBuffer(capacity=512,is_video=True)
+        buffer.add(packet(7,100,b'a'),'tokenIdLLM')
+        buffer.add(packet(9,100,b'c'),'tokenIdLLM')
+        _,frame=buffer.add(packet(10,200,b'd'),'tokenIdLLM')
+        self.assertEqual(frame.data,b'ac')
+
+
+if __name__=='__main__':
+    unittest.main()
