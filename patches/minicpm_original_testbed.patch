--- /dev/null
+++ b/aitestbed/minicpm_split/rtc_codec.py
@@ -0,0 +1,248 @@
+"""Opt-in model codec inside the original Testbed aiortc media path."""
+import asyncio
+import hashlib
+import json
+import os
+import socket
+import threading
+import time
+from pathlib import Path
+
+from aiortc.codecs.base import Encoder, Decoder
+from aiortc.codecs.tokenId import VpxPayloadDescriptor
+from aiortc.mediastreams import VIDEO_TIME_BASE, convert_timebase
+import aiortc.shared as shared
+
+from .client import PROMPT, load_frames
+from .native import EdgeVision, LanguageDecoder
+from .rtp_features import FeatureAssembler, fragment_features, HEADER
+
+
+def settings():
+    path=os.environ.get('MINICPM_RTC_CONFIG')
+    if not path:
+        raise RuntimeError('Set MINICPM_RTC_CONFIG to the pinned local model configuration')
+    return json.loads(Path(path).read_text(encoding='utf-8'))
+
+
+def configure_receive_buffers(pc,requested=32*1024**2):
+    """Bounded per-socket capacity for F32 bursts; leave netem/global sysctls intact.
+
+    Linux's ordinary SO_RCVBUF is capped at 212992 here. The original server is
+    run with sudo for this experiment so SO_RCVBUFFORCE can apply to its own
+    sockets, without increasing the limit for other processes.
+    """
+    transports=[receiver.transport.transport for receiver in pc.getReceivers()]
+    if pc.sctp:
+        transports.append(pc.sctp.transport.transport)
+    seen,records=set(),[]
+    for ice in transports:
+        for protocol in ice.iceGatherer._connection._protocols:
+            sock=protocol.transport.get_extra_info('socket')
+            if sock.fileno() in seen:
+                continue
+            seen.add(sock.fileno())
+            try:
+                sock.setsockopt(socket.SOL_SOCKET,33,requested)  # Linux SO_RCVBUFFORCE
+            except PermissionError:
+                sock.setsockopt(socket.SOL_SOCKET,socket.SO_RCVBUF,requested)
+            actual=sock.getsockopt(socket.SOL_SOCKET,socket.SO_RCVBUF)
+            if actual<2*requested:
+                raise RuntimeError('MiniCPM UDP receive capacity is insufficient; run this local server with sudo')
+            records.append({'socket':sock.getsockname(),'requested_bytes':requested,'actual_bytes':actual})
+    return records
+
+
+class MiniCPMEncoder(Encoder):
+    bridge=None
+    jobs={}
+    acknowledgements={}
+    records={}
+    loop=None
+    channel=None
+
+    @classmethod
+    def preload_bridge(cls):
+        if cls.bridge is None:
+            cls.config=settings()
+            cls.bridge=EdgeVision(cls.config['runtime'],cls.config['tokenizer'],cls.config['projector'])
+        return True
+
+    @classmethod
+    def cleanup_bridge(cls):
+        if cls.bridge is not None:
+            cls.bridge.close()
+            cls.bridge=None
+
+    @classmethod
+    def configure_channel(cls,loop,channel):
+        cls.loop,cls.channel=loop,channel
+        cls.jobs,cls.acknowledgements,cls.records={},{},{}
+
+    @classmethod
+    def send_control(cls,message):
+        cls.loop.call_soon_threadsafe(cls.channel.send,json.dumps(message))
+
+    def encode(self,frame,force_keyframe=False):
+        cls=type(self)
+        job=cls.jobs[int(frame.pts)]
+        row,folder,message_id=job['question'],Path(job['folder']),job['message_id']
+        frames=load_frames(folder,row,cls.config['mode'])
+        metadata,payload=cls.bridge.encode([folder/f['file'] for f in frames],
+                                          PROMPT.format(row['question'],*row['options']))
+        metadata.update(question_id=row['question_id'],frames=frames,mode=cls.config['mode'],
+                        max_tokens=16,feature_bytes=len(payload),
+                        original_feature_sha256=hashlib.sha256(payload).hexdigest())
+        ready=threading.Event()
+        cls.acknowledgements[message_id]=ready
+        cls.send_control({'type':'minicpm_features','message_id':message_id,'metadata':metadata})
+        if not ready.wait(cls.config.get('control_timeout_seconds',60)):
+            raise TimeoutError('Feature metadata was not acknowledged over the original data channel')
+        fragments=fragment_features(payload,message_id)
+        payloads=[bytes(VpxPayloadDescriptor(partition_start=int(index==0),partition_id=0,
+                                            picture_id=message_id%32768))+data
+                  for index,data in enumerate(fragments)]
+        cls.records[message_id]={'question_id':row['question_id'],'feature_bytes':len(payload),
+            'rtp_payload_bytes':sum(map(len,payloads)),'rtp_packets':len(payloads),
+            'edge_encode_seconds':metadata['edge_encode_seconds'],
+            'original_feature_sha256':metadata['original_feature_sha256'],'frames':frames}
+        return payloads,convert_timebase(frame.pts,frame.time_base,VIDEO_TIME_BASE)
+
+    def pack(self,packet):
+        raise ValueError('MiniCPM requires genuine edge vision encoding')
+
+    @property
+    def target_bitrate(self):
+        return 500000
+
+    @target_bitrate.setter
+    def target_bitrate(self,value):
+        # Retain F32 features: no implicit bitrate-dependent feature quantizer.
+        pass
+
+
+class MiniCPMDecoder(Decoder):
+    bridge=None
+    data_channel=None
+    bench_config=[]
+    model_name='minicpm'
+    task_class='real'
+    question_states={}
+    result_output_path=None
+    current_video_path=None
+    current_video_name=None
+    session_finalized=False
+    entries={}
+    _dec_tasks=set()
+    _lock=threading.Lock()
+    _gpu_lock=threading.Lock()
+
+    @classmethod
+    def preload_bridge(cls):
+        if cls.bridge is None:
+            cls.config=settings()
+            cls.bridge=LanguageDecoder(cls.config['runtime'],cls.config['model'])
+        return True
+
+    @classmethod
+    def cleanup_bridge(cls):
+        if cls.bridge is not None:
+            cls.bridge.close()
+            cls.bridge=None
+
+    @classmethod
+    def reset_decoder_state(cls,model_name=None):
+        for task in list(cls._dec_tasks):
+            if not task.done():
+                task.cancel()
+        cls._dec_tasks=set()
+        cls.entries={}
+        cls.bench_config=[]
+        cls.question_states={}
+        cls.data_channel=None
+        cls.result_output_path=None
+        cls.current_video_path=cls.current_video_name=None
+        cls.session_finalized=False
+        if model_name:
+            cls.model_name=model_name
+
+    @classmethod
+    def register_features(cls,message):
+        message_id=message['message_id']
+        metadata=message['metadata']
+        questions={q['question_id']:q for entry in cls.bench_config for q in entry['questions']}
+        if metadata['question_id'] not in questions or metadata['mode']!=cls.config['mode']:
+            raise ValueError('Feature metadata does not belong to this benchmark session')
+        with cls._lock:
+            if message_id in cls.entries:
+                raise ValueError('Duplicate feature message identity')
+            cls.entries[message_id]={'metadata':metadata,
+                'assembler':FeatureAssembler(metadata['feature_bytes'],message_id),
+                'registered_at':time.perf_counter(),'started':False,'question':questions[metadata['question_id']]}
+
+    def decode(self,encoded_frame):
+        cls=type(self)
+        if not encoded_frame.data:
+            return []
+        message_id=HEADER.unpack_from(encoded_frame.data)[0]
+        with cls._lock:
+            entry=cls.entries[message_id]
+            if entry['started']:
+                return []
+            entry['assembler'].add(encoded_frame.data)
+        shared.loop.call_soon_threadsafe(cls.schedule_inference,message_id)
+        return []
+
+    @classmethod
+    def schedule_inference(cls,message_id):
+        with cls._lock:
+            entry=cls.entries[message_id]
+            if entry['started']:
+                return
+            entry['started']=True
+            payload,loss=entry['assembler'].finish()
+        task=asyncio.create_task(cls.infer(entry,payload,loss))
+        cls._dec_tasks.add(task)
+        task.add_done_callback(cls._dec_tasks.discard)
+
+    @classmethod
+    def generate(cls,metadata,payload):
+        begin=time.perf_counter()
+        with cls._gpu_lock:
+            result=cls.bridge.generate(metadata,payload,max_tokens=16)
+        return result,time.perf_counter()-begin
+
+    @classmethod
+    async def infer(cls,entry,payload,loss):
+        metadata=entry['metadata']
+        record={'question_id':metadata['question_id'],'mode':metadata['mode'],'frames':metadata['frames'],
+            'feature_bytes':len(payload),'feature_sha256':hashlib.sha256(payload).hexdigest(),
+            'original_feature_sha256':metadata['original_feature_sha256'],'loss':loss,
+            'edge_encode_seconds':metadata['edge_encode_seconds'],'server_pid':os.getpid(),
+            'transport':'original Testbed aiortc RTP/SRTP; metadata/results on reliable data channel'}
+        try:
+            result,duration=await asyncio.to_thread(cls.generate,metadata,payload)
+            record.update(raw_response=result['text'],result=result,server_inference_seconds=duration)
+        except Exception as exc:
+            record.update(raw_response='',error=type(exc).__name__+': '+str(exc))
+        record['metadata_to_result_seconds']=time.perf_counter()-entry['registered_at']
+        entry['question'][cls.model_name]=record['raw_response']
+        entry['question']['minicpm_details']=record
+        entry['result']=record
+        cls.data_channel.send(json.dumps({'type':'MINICPM_RESULT','record':record}))
+
+    @classmethod
+    async def finish_session(cls,receivers):
+        # Preserve original RTP reassembly, including an explicit final-frame
+        # drain. The selected profiles' finite queues are allowed to empty.
+        await asyncio.sleep(cls.config.get('media_drain_seconds',5.0))
+        for receiver in receivers:
+            receiver.flush_minicpm()
+        deadline=time.monotonic()+2
+        while any(not entry['started'] for entry in cls.entries.values()) and time.monotonic()<deadline:
+            await asyncio.sleep(.05)
+        for message_id in cls.entries:
+            cls.schedule_inference(message_id)  # entire-message loss -> all zero
+        if cls._dec_tasks:
+            await asyncio.gather(*list(cls._dec_tasks))
+        cls.session_finalized=True
diff --git a/aitestbed/minicpm_split/rtc_track.py b/aitestbed/minicpm_split/rtc_track.py
new file mode 100644
--- /dev/null
+++ b/aitestbed/minicpm_split/rtc_track.py
@@ -0,0 +1,101 @@
+"""Requested native question frames in the original Testbed video-track slot."""
+import asyncio
+import json
+import time
+from fractions import Fraction
+from pathlib import Path
+from types import SimpleNamespace
+
+import av
+import numpy as np
+from PIL import Image
+from aiortc import VideoStreamTrack, MediaStreamError
+
+from .client import load_frames
+from .rtc_codec import MiniCPMEncoder
+
+
+class MiniCPMQuestionTrack(VideoStreamTrack):
+    def __init__(self,video_path):
+        super().__init__()
+        self.config=MiniCPMEncoder.config
+        video_id=int(Path(video_path).parent.name.rsplit('_',1)[1])
+        manifest=json.loads(Path(self.config['questions']).read_text(encoding='utf-8'))
+        self.jobs=[(index+1,row) for index,row in enumerate(manifest) if row['video_id']==video_id]
+        self.jobs.sort(key=lambda job:job[1]['timestamp_seconds'])
+        if len(self.jobs)!=5:
+            raise ValueError('Each selected video must have exactly five fixed questions')
+        first=self._frames(self.jobs[0][1])[1][-1]
+        self.stream=SimpleNamespace(width=first['size'][0],height=first['size'][1])
+        self.fps=first['source_fps']
+        self.frame_count=0
+        self._index=0
+        self._complete=False
+        self._first_frame_time=self._last_frame_time=None
+        self._previous=None
+        self._chunks=[]
+        self.finish_event=asyncio.Event()
+
+    def _frames(self,row):
+        folder=Path(self.config['frames'])/row['question_id'].replace(' ','_')
+        return folder,load_frames(folder,row,self.config['mode'])
+
+    async def recv(self):
+        if self._previous is not None:
+            # recv() is called again only after the previous frame's RTP
+            # payloads have been sent by the unmodified aiortc sender.
+            from clients.realtime_webrtc_vlm_client import VLMVideoChunk
+            record=MiniCPMEncoder.records[self._previous]
+            self._last_frame_time=time.time()
+            last=record['frames'][-1]
+            self._chunks.append(VLMVideoChunk(frame_index=last['frame_index'],timestamp=self._last_frame_time,
+                pts=round(last['actual_seconds']*90000),bytes_sent=record['rtp_payload_bytes'],
+                width=self.stream.width,height=self.stream.height))
+            self._previous=None
+        if self._index>=len(self.jobs):
+            self._complete=True
+            MiniCPMEncoder.send_control({'type':'minicpm_media_finished'})
+            # Keep RTP/RTCP alive until server drains the final partial frame.
+            await self.finish_event.wait()
+            raise MediaStreamError('All requested question-frame features sent')
+        message_id,row=self.jobs[self._index]
+        self._index+=1
+        folder,frames=self._frames(row)
+        pts=round(frames[-1]['actual_seconds']*90000)
+        if pts in MiniCPMEncoder.jobs:
+            raise ValueError('Duplicate query frame timestamp')
+        MiniCPMEncoder.jobs[pts]={'question':row,'folder':str(folder),'message_id':message_id}
+        with Image.open(folder/frames[-1]['file']) as image:
+            frame=av.VideoFrame.from_ndarray(np.asarray(image.convert('RGB')).copy(),format='rgb24')
+        frame.pts,frame.time_base=pts,Fraction(1,90000)
+        self.frame_count+=len(frames)
+        self._previous=message_id
+        if self._first_frame_time is None:
+            self._first_frame_time=time.time()
+        return frame
+
+    @property
+    def total_bytes(self):
+        return sum(MiniCPMEncoder.records[mid]['rtp_payload_bytes'] for mid,_ in self.jobs
+                   if mid in MiniCPMEncoder.records)
+
+    @property
+    def chunks(self):
+        return self._chunks
+
+    @property
+    def first_frame_time(self):
+        return self._first_frame_time
+
+    @property
+    def last_frame_time(self):
+        return self._last_frame_time
+
+    @property
+    def video_send_complete(self):
+        return self._complete
+
+    def stop(self):
+        self._complete=True
+        self.finish_event.set()
+        super().stop()
