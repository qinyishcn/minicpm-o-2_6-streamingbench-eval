+import asyncio
+import unittest
+from aiortc.codecs import CODECS, get_encoder, get_decoder
+from aiortc.rtp import RtpPacket, HeaderExtensionsMap
+from aiortc.rtcrtpparameters import RTCRtpParameters, RTCRtpHeaderExtensionParameters
+from aiortc.codecs.tokenId import VpxPayloadDescriptor
+from minicpm_split.rtp_features import fragment_features
+from pylibsrtp import Policy, Session
+from aiortc.rtcrtpsender import RTCRtpSender, RTP_HISTORY_SIZE
+
+
+class MiniCPMCodecRegistrationTests(unittest.TestCase):
+    def test_original_fork_does_not_retransmit_without_negotiated_rtx(self):
+        # The shipped Testbed fork differs from generic upstream aiortc here.
+        # Preserve and verify its actual branch, including an available packet.
+        sender = object.__new__(RTCRtpSender)
+        packet = RtpPacket(payload_type=109, sequence_number=42, timestamp=123)
+        packet.ssrc, packet.payload = 7, b'feature'
+        sender._RTCRtpSender__rtp_history = {42 % RTP_HISTORY_SIZE: packet}
+        sender._RTCRtpSender__rtx_payload_type = None
+        sent = []
+
+        class Transport:
+            async def _send_rtp(self, data):
+                sent.append(data)
+
+        sender._RTCRtpSender__transport = Transport()
+        sender._RTCRtpSender__log_debug = lambda *args: None
+        sender._RTCRtpSender__rtp_header_extensions_map = HeaderExtensionsMap()
+        asyncio.run(sender._retransmit(42))
+        self.assertEqual(sent, [])
+        # A positive control makes sure this checks the real retransmit path.
+        sender._RTCRtpSender__rtx_payload_type = 110
+        sender._RTCRtpSender__rtx_sequence_number = 100
+        sender._rtx_ssrc = 8
+        asyncio.run(sender._retransmit(42))
+        self.assertEqual(len(sent), 1)
+        retransmission = RtpPacket.parse(sent[0])
+        self.assertEqual(retransmission.payload_type, 110)
+        self.assertEqual(retransmission.payload[:2], bytes([0, 42]))
+
+    def test_minicpm_codec_is_opt_in_beside_liquid(self):
+        choices={codec.mimeType:codec for codec in CODECS['video']}
+        self.assertIn('video/tokenIdLLM',choices)
+        self.assertIn('video/tokenIdMiniCPM',choices)
+        codec=choices['video/tokenIdMiniCPM']
+        self.assertEqual(type(get_encoder(codec)).__name__,'MiniCPMEncoder')
+        self.assertEqual(type(get_decoder(codec)).__name__,'MiniCPMDecoder')
+
+    def test_real_srtp_protect_accepts_the_largest_feature_packet(self):
+        extensions=HeaderExtensionsMap()
+        extensions.configure(RTCRtpParameters(headerExtensions=[
+            RTCRtpHeaderExtensionParameters(id=1,uri='urn:ietf:params:rtp-hdrext:sdes:mid'),
+            RTCRtpHeaderExtensionParameters(id=3,uri='http://www.webrtc.org/experiments/rtp-hdrext/abs-send-time')]))
+        packet=RtpPacket(payload_type=109,sequence_number=1,timestamp=123)
+        packet.ssrc=7
+        packet.extensions.mid='0'
+        packet.extensions.abs_send_time=12345
+        packet.payload=bytes(VpxPayloadDescriptor(1,0,picture_id=200))+fragment_features(bytes(8000),200)[0]
+        plain=packet.serialize(extensions)
+        tx=Session(Policy(key=bytes(range(30)),ssrc_type=Policy.SSRC_ANY_OUTBOUND))
+        rx=Session(Policy(key=bytes(range(30)),ssrc_type=Policy.SSRC_ANY_INBOUND))
+        protected=tx.protect(plain)
+        self.assertEqual(rx.unprotect(protected),plain)
+        self.assertLessEqual(len(protected)+20+8,1500)
+
+
+if __name__=='__main__':
+    unittest.main()
