+import unittest
+
+from analysis.metrics import MetricsCalculator
+
+
+class RealtimeAccuracyTests(unittest.TestCase):
+    def test_bare_multiple_choice_and_legacy_json(self):
+        for text in ['A',' a ','(A)','A.','{"answer":"A"}']:
+            self.assertEqual(MetricsCalculator.extract_answer(text),'A')
+        for text in ['',None,'I cannot tell','A or B']:
+            self.assertIsNone(MetricsCalculator.extract_answer(text))
+
+    def test_invalid_and_missing_answers_remain_in_denominator(self):
+        questions=[{'task_type':'object','answer':'A','minicpm':'A'},
+                   {'task_type':'object','answer':'B','minicpm':'unknown'},
+                   {'task_type':'object','answer':'C'}]
+        stats=MetricsCalculator.calculate_task_accuracy([{'questions':questions}],'minicpm',0,'real')
+        self.assertEqual(stats['total']['total'],3)
+        self.assertEqual(stats['total']['correct'],1)
+        self.assertAlmostEqual(stats['total']['accuracy'],1/3)
+
+    def test_case_insensitive_model_key_is_used(self):
+        stats=MetricsCalculator.calculate_task_accuracy([{'questions':[
+            {'task_type':'object','answer':'B','MiniCPM':'B'}]}],'minicpm',0,'real')
+        self.assertEqual(stats['total']['correct'],1)
+
+
+if __name__=='__main__':
+    unittest.main()
diff --git a/aitestbed/docs/minicpm_testbed_rtc.md b/aitestbed/docs/minicpm_testbed_rtc.md
new file mode 100644
--- /dev/null
+++ b/aitestbed/docs/minicpm_testbed_rtc.md
@@ -0,0 +1,104 @@
+# MiniCPM-o 2.6 接入原版 Testbed RTC
+
+端侧加载 F16 视觉编码器和 resampler，服务器只加载 Q4_K_M 语言模型。
+两者在本机 WSL Ubuntu 中作为独立进程运行，共享 RTX 3070。
+中间数据为 F32 视觉 embedding；不是 JPEG 或模型最终答案。
+
+当前实际调用链：
+
+```text
+orchestrator.py -> scenarios/realtime_video.py
+  -> RealtimeWebRTCVLMClient -> RTCPeerConnection / original RTP sender
+  -> MiniCPMEncoder -> original UDP / DTLS / SRTP -> Linux lo HTB/netem
+  -> original RTP receiver / jitter / decoder queue -> MiniCPMDecoder
+  -> native language-model inference -> original reliable DataChannel
+  -> original benchmark JSON + TrafficLogger SQLite + capture/report
+```
+
+TCP/18124 用于原版信令；视觉特征经 UDP/RTP/SRTP。问题、形状/位置/文本
+token 元数据及答案使用原版可靠 DataChannel。模型使用独立的
+`video/tokenIdMiniCPM` codec，Liquid 默认 codec 保留。
+
+输入仍是固定视频 1–25、每视频 5 问，共 125 题。单帧取提问前最近原生帧；
+四帧为该帧及紧邻前三帧。复用已核验的 588×336 JPEG 缓存，有空间处理，
+没有时间抽样。当前 track 只按问题顺序发送这批特征，**不是持续原生 FPS 流量**。
+原视频时间轴/持续流量与按提问点加速回放的正式实验口径尚待选择。
+
+## 保留的原版行为与必要模型适配
+
+- 使用原版 orchestrator、scenario、TCP 信令、ICE/DTLS/SRTP、RTP 收发、
+  netemu profile、抓包和 SQLite 日志流程。`rtc_batch.py` 只调用原 CLI
+  并记录 tc/UDP 状态；25 个 run 对应数值顺序视频 1–25，保留原版 20 秒 run 间隔。
+- 原 SRTP 实测要求保留 Liquid 的 1100 字节 RTP 载荷上限；扣除模型分片头
+  及既有 payload 描述后，每包承载 1080 字节 F32 特征。
+  单帧 2549 包、四帧 10195 包，实测最大媒体 IP 包 1167 字节。
+  这与离线实验的 1432 字节预算不同，结果应分开解读。
+- 缺包对应的原特征位置置零，形状与顺序不变；不复用其他问题或前帧数据。
+  大特征使用 16384 包 jitter buffer，最后一帧通过显式结束控制和排空期限交给
+  原 decoder queue。局部晚到/重组舍弃也属于最终特征缺失。
+- 服务器请求每个自己的 UDP socket 的 32 MiB 接收容量，Linux 报告有效 64 MiB，
+  因此本地服务器使用 sudo；不修改全局 sysctl，也不调大 netem profile 队列。
+- SDP 不协商 RTX。当前 Testbed fork 的 `_retransmit` 只在有 RTX payload type
+  时发送重传；已通过无 RTX 及有 RTX 正控制验证。NACK/RTCP 机制保留，
+  不能仅凭通用 aiortc 文档推断本 fork 的实际重传行为。
+- 修正原评分路径对裸 A–D 的解析和缺失/无效答案分母处理，保留旧 JSON 答案兼容。
+  独立 MiniCPM 汇总按此前固定 A–D 格式评分；无效答案计错，分母固定。
+
+## 本机运行
+
+从 `aitestbed` 执行，使用已有原版 Testbed Linux 依赖环境和 b11516 CUDA 12.8
+运行时。`native.py` 在加载前核对模型、tokenizer 与原生库 SHA-256。
+已有 Linux Liquid checkout 不被改写；PYTHONPATH 显式指向本项目的 fork。
+
+```bash
+export PROJECT='/mnt/c/Users/qinyi/Documents/AItest 2/6G-Testbed'
+export PYTHONPATH="$PROJECT/aiortc-main-clean/src:$PROJECT/aitestbed:$PROJECT/netemu/src"
+export LD_LIBRARY_PATH='/home/qinyi/.cache/minicpm-native/b11516-cuda12.8/llama-b11516:/home/qinyi/6G-Testbed/venv/lib/python3.12/site-packages/nvidia/cuda_runtime/lib:/home/qinyi/6G-Testbed/venv/lib/python3.12/site-packages/nvidia/cublas/lib:/usr/lib/wsl/lib'
+cd "$PROJECT/aitestbed"
+PYTHON=/home/qinyi/6G-Testbed/venv/bin/python
+
+$PYTHON -m minicpm_split.prepare_rtc --assets '/mnt/c/Users/qinyi/Documents/ChatGPT/mobileAI' --runtime /home/qinyi/.cache/minicpm-native/b11516-cuda12.8/llama-b11516 --output results/new_minicpm_rtc
+export MINICPM_RTC_CONFIG="$PROJECT/aitestbed/results/new_minicpm_rtc/configs/native4_model.json"
+
+# 终端一：原版 server，选择 MiniCPM codec；单帧改为 single 配置。
+sudo -n env "PYTHONPATH=$PYTHONPATH" "LD_LIBRARY_PATH=$LD_LIBRARY_PATH" "MINICPM_RTC_CONFIG=$MINICPM_RTC_CONFIG" "$PYTHON" -m server.realtime_vlm_server --model minicpm --config results/new_minicpm_rtc/configs/native4_scenarios.yaml --signaling-port 18124
+
+# 终端二：原版 orchestrator 的 25 视频无扰动基线。
+$PYTHON -m minicpm_split.rtc_batch --root results/new_minicpm_rtc --mode native4 --profiles no_emulation --capture-root /home/qinyi/minicpm_rtc_captures/new_run --runs 25
+
+# 完成后独立重评分和原始/置零特征字节核验；需原生运行时及帧缓存。
+$PYTHON -m minicpm_split.rtc_report --root results/new_minicpm_rtc --modes native4 --profiles no_emulation --reencode --output results/new_minicpm_rtc/audit
+```
+
+仅重评分已保存的答案及缺包布局可省略 `--reencode`；使用 `--questions` 指定
+同哈希的可移植 manifest。部分丢包的实际特征字节重建需要 `--reencode`。
+单帧、四帧必须与各自服务器 mode 匹配；切换 mode 前停止本次服务器并重启。
+同一条件需要继续时可使用原版 `--resume`，不要覆盖先前证据或静默重试。
+
+后续受扰动批次将使用原版 `lossy`、`5qi_7`、`congested`，并在正式回放口径
+选定后启动；不得改小带宽/时延/队列扰动以获取预期曲线。
+
+## 2026-10-10 网络诊断（四帧，仅一个视频/5 问）
+
+| 原版 profile | 答对/5 | 配置随机丢包 | 实际不可用特征包 |
+|---|---:|---:|---:|
+| no_emulation | 4 | 0% | 0.000% |
+| lossy | 4 | 10% | 10.060% |
+| 5qi_7 | 4 | 0.1% | 87.058% |
+| congested | 2 | gemodel 3% 设定 | 98.389% |
+
+这是链路诊断，不能用五题准确率代替完整 125 题性能。20 条输入已逐题重新编码，
+按记录缺包索引置零，全部原始及实际受损特征哈希复现。无扰动前三问的首步完整
+logits 哈希与独立 Linux 未拆分 helper 一致。四组均有 UDP/RTP 抓包和 tc 丢包证据。
+
+`5qi_7` 的原版队列只有 1000 包，`congested` 为 1 Mbit/s、200 包队列；
+大 F32 突发可造成额外队列溢出。因此配置随机丢包率、tc 总丢包计数、
+抓到的 RTP 包数及模型最终可用特征包数必须分别报告，不能互相替代。
+
+当前保存的 `metadata_to_result_seconds` 从服务器元数据登记到完整答案生成，
+不包含端侧编码与答案回传，不能命名为端到端延迟。`server_inference_seconds`
+包含模型串行 GPU 队列等待。答案一次性回传，没有逐 token TTFT 测量。
+原版视频级日志保留，但五个独立问题的结果消息间隔不能解释为文本生成 stall。
+
+该 Linux CUDA 基线与此前 Windows Vulkan 离线实验分开比较。完整 profile
+准确率必须以同一 Linux/RTC 无扰动条件为基准，并保留失败、缺失及原始回答。
