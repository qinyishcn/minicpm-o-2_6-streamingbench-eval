+"""Prepare original Testbed sample directories from the verified 125 questions."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import yaml
+
+
+def main():
+    parser=argparse.ArgumentParser()
+    parser.add_argument('--assets',required=True)
+    parser.add_argument('--runtime',required=True)
+    parser.add_argument('--output',default='results/minicpm_rtc')
+    args=parser.parse_args()
+    assets=Path(args.assets).resolve()
+    output=Path(args.output).resolve()
+    questions=assets/'results/q4_k_m_single_native/questions_manifest.json'
+    rows=json.loads(questions.read_text(encoding='utf-8'))
+    if len(rows)!=125 or sorted({r['video_id'] for r in rows})!=list(range(1,26)):
+        raise ValueError('Expected the verified first 25 videos and 125 questions')
+    configs=output/'configs'
+    configs.mkdir(parents=True,exist_ok=True)
+    for mode in ['single','native4']:
+        dataset=output/'dataset'/mode
+        for video_id in range(1,26):
+            folder=dataset/f'sample_{video_id}'
+            folder.mkdir(parents=True,exist_ok=True)
+            target=assets/f'data/videos/{video_id:03d}.mp4'
+            link=folder/f'{video_id:03d}.mp4'
+            if not link.exists():
+                link.symlink_to(target)
+            subset=[r for r in rows if r['video_id']==video_id]
+            if len(subset)!=5:
+                raise ValueError('Expected five questions per video')
+            path=folder/'questions.json'
+            if not path.exists():
+                path.write_text(json.dumps([{'video_id':video_id,'questions':subset}],indent=2),encoding='utf-8')
+        model_config={'runtime':str(Path(args.runtime).resolve()),
+            'model':str(assets/'models/Model-7.6B-Q4_K_M.gguf'),
+            'projector':str(assets/'models/mmproj-model-f16.gguf'),
+            'tokenizer':str(Path('models/minicpm-o-tokenizer-only.gguf').resolve()),
+            'questions':str(questions),'frames':str(assets/'data/native_frames'),'mode':mode,
+            'media_drain_seconds':5.0,'control_timeout_seconds':60,
+            'questions_sha256':hashlib.sha256(questions.read_bytes()).hexdigest()}
+        (configs/f'{mode}_model.json').write_text(json.dumps(model_config,indent=2),encoding='utf-8')
+        scenario={'scenarios':{'realtime_video_understanding':{
+            'type':'realtime_video_understanding','provider':'vlm-local','model':'minicpm',
+            'description':'Original Testbed RTC with native question-frame MiniCPM features',
+            'target_fps':None,'stream':True,'signaling_host':'127.0.0.1','signaling_port':18124,
+            'task_config':{'task_class':'real','po_thd':0,'video_paths':str(dataset),'results_dir':str(dataset)},
+            'prompts':['Use the verified benchmark multiple-choice question.']}},
+            'defaults':{'retry_count':0}}
+        (configs/f'{mode}_scenarios.yaml').write_text(yaml.safe_dump(scenario,sort_keys=False),encoding='utf-8')
+    print(json.dumps({'configs':str(configs),'questions':125,'videos':25,'frames':'native cached indices; no temporal resampling'}))
+
+
+if __name__=='__main__':
+    main()
